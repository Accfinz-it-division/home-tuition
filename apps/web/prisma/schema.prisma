generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  TEACHER
  STUDENT
  PARENT
}

enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  phone         String?
  password      String
  role          Role
  name          String
  nic           String?   @unique
  dob           DateTime?
  profilePic    String?
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())

  teacher       Teacher?
  student       Student?
  parent        Parent?
  notifications Notification[]
  sessions      Session[]      // ✅ Add this
}

model Teacher {
  id             String             @id @default(cuid())
  userId         String             @unique
  user           User               @relation(fields: [userId], references: [id])
  qualifications String?
  bio            String?
  status         VerificationStatus @default(PENDING)
  courses        Course[]
}

model Student {
  id          String       @id @default(cuid())
  userId      String       @unique
  user        User         @relation(fields: [userId], references: [id])
  grade       Int?
  parentId    String?
  parent      Parent?      @relation(fields: [parentId], references: [id])
  enrollments Enrollment[]
  attendances Attendance[]
  payments    Payment[]
  marks       Mark[]       // ✅ Added for Marks
}

model Parent {
  id       String    @id @default(cuid())
  userId   String    @unique
  user     User      @relation(fields: [userId], references: [id])
  nic      String
  students Student[]
}

model Course {
  id           String        @id @default(cuid())
  title        String
  category     String
  grade        Int?
  description  String?
  thumbnail    String?
  firstFee     Decimal       @db.Decimal(10, 2)
  regularFee   Decimal       @db.Decimal(10, 2)
  teacherId    String
  teacher      Teacher       @relation(fields: [teacherId], references: [id])
  enrollments  Enrollment[]
  resources    Resource[]
  zoomMeetings ZoomMeeting[]
  exams        Exam[]        // ✅ Added for Exams
  createdAt    DateTime      @default(now())
}

model Enrollment {
  id        String   @id @default(cuid())
  studentId String
  student   Student  @relation(fields: [studentId], references: [id])
  courseId  String
  course    Course   @relation(fields: [courseId], references: [id])
  createdAt DateTime @default(now())
  @@unique([studentId, courseId])
}

model Payment {
  id         String        @id @default(cuid())
  studentId  String
  student    Student       @relation(fields: [studentId], references: [id])
  courseId   String
  amount     Decimal       @db.Decimal(10, 2)
  month      String
  status     PaymentStatus @default(PENDING)
  gatewayRef String?
  createdAt  DateTime      @default(now())
}

model Attendance {
  id        String           @id @default(cuid())
  studentId String
  student   Student          @relation(fields: [studentId], references: [id])
  courseId  String
  date      DateTime
  status    AttendanceStatus
}

model Resource {
  id        String   @id @default(cuid())
  courseId  String
  course    Course   @relation(fields: [courseId], references: [id])
  type      String
  title     String
  fileUrl   String
  createdAt DateTime @default(now())
}

model Notification {
  id      String   @id @default(cuid())
  userId  String
  user    User     @relation(fields: [userId], references: [id])
  channel String
  message String
  sentAt  DateTime @default(now())
}

model ZoomMeeting {
  id           String   @id @default(cuid())
  courseId     String
  title        String
  startTime    DateTime
  endTime      DateTime
  link         String
  recordingUrl String?
  createdAt    DateTime @default(now())

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
}

model Exam {
  id          String   @id @default(cuid())
  courseId    String
  title       String
  examDate    DateTime
  totalMarks  Int
  description String?
  createdAt   DateTime @default(now())

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  marks  Mark[]
}

model Mark {
  id        String   @id @default(cuid())
  examId    String
  studentId String
  score     Float
  createdAt DateTime @default(now())

  exam    Exam    @relation(fields: [examId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([examId, studentId])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
}